# Copy this file to .env and fill in your values

# Port the API and Socket.IO server listen on
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/healthtwin
# MongoDB Atlas (replace user, password and cluster):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthtwin?retryWrites=true&w=majority

# Frontend origin(s) allowed by CORS. Comma-separate if you need more than one.
CLIENT_URL=http://localhost:5173

# Serves public/socket-test.html when not "production"
NODE_ENV=development
