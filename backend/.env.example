# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
# Demo ambulance speed in km/h (default 60). Raise it to make a trip finish sooner.
# AMBULANCE_SPEED_KMH=60
MONGO_URI=mongodb://127.0.0.1:27017/healthtwin
CLIENT_ORIGIN=http://localhost:5173

# Required in production: random strings of 32+ characters (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=

# 'console' prints emails (reset links) to the server log; 'resend' sends through the Email API
MAIL_PROVIDER=console
MAIL_FROM=HealthTwin AI <no-reply@healthtwin.example>
RESEND_API_KEY=

# Behind a reverse proxy (so rate limits and audit logs see the real IP)
TRUST_PROXY=false

# Optional: password for seeded demo accounts (default is printed by `npm run seed`)
# SEED_PASSWORD=

# Where uploaded photos and documents are stored (outside any public folder)
# UPLOAD_DIR=./uploads
# Comma-separated drug names flagged as blood thinners
# BLOOD_THINNER_DRUGS=warfarin,apixaban,rivaroxaban,dabigatran,clopidogrel,ticagrelor,prasugrel
