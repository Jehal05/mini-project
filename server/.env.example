PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/healthtwin
JWT_SECRET=change-me-before-use
CLIENT_URL=http://localhost:5173

# Hospital discovery (Phase 8)
# Road distance and ETA provider: osrm (free, default) | mapbox | google
ROUTING_PROVIDER=osrm
# Needed only for mapbox or google. Without it the server uses a labelled straight-line estimate.
MAPS_API_KEY=
OSRM_URL=https://router.project-osrm.org
# Seconds before a notified hospital counts as "not answering" (feature 60)
NO_ANSWER_TIMEOUT_SECONDS=120
