PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/healthtwin
# Signs login tokens. In production use a long random value (32+ characters), e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-use
# Phase 14: true lets the old dev headers (x-hospital-id etc.) work without signing in. Never in production.
DEV_AUTH=false
# Password for the demo accounts made by npm run seed:users (default is in the README)
DEMO_PASSWORD=
CLIENT_URL=http://localhost:5173

# Hospital discovery (Phase 8)
# Road distance and ETA provider: osrm (free, default) | mapbox | google
ROUTING_PROVIDER=osrm
# Needed only for mapbox or google. Without it the server uses a labelled straight-line estimate.
MAPS_API_KEY=
OSRM_URL=https://router.project-osrm.org
# Seconds before a notified hospital counts as "not answering" (feature 60)
NO_ANSWER_TIMEOUT_SECONDS=120

# Hospital notification (Phase 9)
# Web push for staff whose tab is closed. Generate keys with: npx web-push generate-vapid-keys
# Leave empty to disable push (the server logs it and carries on).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# How often (seconds) the server checks for hospitals that have not answered
NO_ANSWER_SWEEP_SECONDS=5

# Ambulance simulation (Phase 10)
# Simulated ambulance speed and how often it moves (seconds). Raise the speed to make demos quicker.
AMBULANCE_SPEED_KMH=60
AMBULANCE_TICK_SECONDS=2

# Emergency prioritization (Phase 12). Order: risk,wait,distance. Any positive numbers, they are normalised.
PRIORITY_WEIGHTS=0.5,0.3,0.2
PRIORITY_WAIT_CAP_MIN=30
PRIORITY_DISTANCE_CAP_KM=20

# Admin dev login (Phase 12). Send it as the x-admin-token header. Leave empty to disable the admin API.
ADMIN_DEV_TOKEN=

# Backups (Phase 12). Backups contain patient data, so keep them off git and off the app server.
BACKUP_DIR=
BACKUP_KEEP=14
# 64 hex characters. Make one with: node scripts/backup.js keygen. Required in production.
BACKUP_ENCRYPTION_KEY=
ALLOW_PRODUCTION_RESTORE=false
